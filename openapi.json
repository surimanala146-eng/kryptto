    "/api/market-data/candles": {
      "get": {
        "operationId": "MarketDataController_getCandles",
        "parameters": [
          {
            "name": "toMs",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "fromMs",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1710000000000
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": 500
            }
          },
          {
            "name": "timeframe",
            "required": true,
            "in": "query",
            "schema": {
              "enum": [
                "1m",
                "5m",
                "15m",
                "30m",
                "1h",
                "4h",
                "1d",
                "1w"
              ],
              "type": "string"
            }
          },
          {
            "name": "symbol",
            "required": true,
            "in": "query",
            "schema": {
              "example": "BTCUSDT"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "OHLCV candle history for a symbol + timeframe",
        "tags": [
          "market-data"
        ]
      }
    },
