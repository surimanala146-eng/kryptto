# Data layer: "kryptto" (default — the backend in ../server) or "demo"
# (upstream OpenCharts in-browser demo engine + bundled real OHLC).
VITE_DATA_SOURCE=kryptto

# Optional: talk to the backend directly instead of the dev-server proxy.
# Must include the scheme and no trailing slash; /api is appended.
# VITE_API_URL=http://localhost:8080

# Optional: explicit WebSocket base (defaults to VITE_API_URL with ws://, or
# same-origin — the Vite dev server proxies /ws to the backend).
# VITE_WS_URL=ws://localhost:8080
