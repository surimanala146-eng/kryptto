# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Comma-separated list. Use * to allow any origin (dev only).
CORS_ORIGINS=*
# Serve the built-in terminal preview at / (true/false)
SERVE_PREVIEW=true

# ── Security ──────────────────────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION. openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Market data ───────────────────────────────────────────────────────────
# auto  → try Binance live feed first, fall back to the built-in simulator
# live  → Binance only (fails hard if unreachable)
# simulated → built-in simulator only
MARKET_DATA_MODE=auto
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
# How many USDT-quoted pairs to stream (by 24h quote volume)
BINANCE_MAX_SYMBOLS=120
# Simulator tick cadence (ms)
SIMULATOR_TICK_INTERVAL_MS=750
# Candle history depth served per timeframe (bars)
CANDLE_HISTORY_DEPTH=1000

# ── Persistence ───────────────────────────────────────────────────────────
# SQLite database file (created automatically). Use :memory: for ephemeral runs.
DATABASE_PATH=data/kryptto.db
